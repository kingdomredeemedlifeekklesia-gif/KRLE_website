# ================================================
# DATABASE CONFIGURATION - Local SQLite
# ================================================
# This uses a local SQLite database for development and testing.
# For production, replace with a real PostgreSQL connection string.
DATABASE_URL=file:./dev.db

# ================================================
# SUPABASE CONFIGURATION
# ================================================
# Supabase public URL (found in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Supabase service role key (server-side only, keep secret)
# This is only used server-side for admin operations and Supabase Storage
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ================================================
# YOUTUBE INTEGRATION
# ================================================
# YouTube API key for fetching sermon videos
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# Your church's YouTube channel ID (can be found in channel settings)
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# ================================================
# PAYSTACK PAYMENT INTEGRATION
# ================================================
# Paystack public key (safe to expose on frontend)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Paystack secret key (server-side only, keep secret)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# ================================================
# ADMIN & SECURITY
# ================================================
# Admin password for accessing admin panel
NEXT_PUBLIC_ADMIN_PASSWORD=your_secure_admin_password_here

# ================================================
# SOCIAL MEDIA LINKS
# ================================================
# Configure your church's social media profiles
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/your-church
NEXT_PUBLIC_X_URL=https://x.com/your-church
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@your-church
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/your-church
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/your-church
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@your-church

# ================================================
# DEPLOYMENT & LOGGING
# ================================================
# Environment type (development, production)
NODE_ENV=production
